# AlphaDesk AI - local development configuration.
#
# Copy this file to .env before starting the stack:
#     cp .env.example .env
#
# These credentials are FOR LOCAL DEVELOPMENT ONLY. They are not secrets, and must
# never be reused for anything reachable from a network you do not control.
#
# Where each hostname applies:
#   - The backend container reaches Postgres at host "postgres" (the Compose service
#     name). This is wired up in docker-compose.yml; you don't set it here.
#   - Tools on your Mac (DataGrip / DB Navigator, psql) reach it at localhost:5433.
#     Port 5433 is used because a native PostgreSQL already listens on 5432 here.
#
# Keep POSTGRES_PASSWORD URL-safe. It is embedded in a connection string, so
# characters like @ : / ? # & would be mis-parsed as part of the URL itself.

POSTGRES_USER=alphadesk
POSTGRES_PASSWORD=alphadesk_dev_password
POSTGRES_DB=alphadesk
